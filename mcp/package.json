{
  "name": "@openbiox/bizard-mcp",
  "version": "0.1.1",
  "description": "MCP server for the Bizard biomedical visualization atlas: search, adapt, cite, and contribute chart tutorials",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "bizard-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbiox/Bizard.git",
    "directory": "mcp"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc && cp -r src/snapshot dist/snapshot",
    "build:bundle": "python3 ../.github/scripts/build-bundle.py --out src/snapshot",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
